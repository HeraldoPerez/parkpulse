{
  "name": "parkpulse",
  "version": "0.0.0",
  "private": true,
  "description": "Current alerts and closures for the national parks you're visiting, on one page",
  "license": "MIT",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "test": "npm test --workspaces",
    "build": "npm run build -w client",
    "start": "npm start -w server"
  },
  "engines": {
    "node": ">=22.22"
  }
}
